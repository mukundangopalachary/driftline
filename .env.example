# Copy to .env (git-ignored) and fill in. Never commit .env.

# Postgres (read by docker-compose.yml and the API)
POSTGRES_USER=driftline
POSTGRES_PASSWORD=driftline_dev
POSTGRES_DB=driftline

# API (defaults match docker-compose when running the API on the host)
# DB_URL=jdbc:postgresql://localhost:5432/driftline
# REDIS_HOST=localhost
# REDIS_PORT=6379
# API_PORT=8082

# GitHub OAuth app (decisions/0006, 0011). Create one in GitHub developer settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT signing keys, ES256, base64 of a PEM on one line (decisions/0015).
# Generate with: scripts/gen-dev-keys.sh
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
